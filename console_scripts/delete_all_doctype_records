# System Console - Bulk delete docs with linked Workflow Actions
# REMEMBER: Enable "Commit" toggle before running

target_doctype = "Employee Visa Cancellation"
target_filters = {}  # empty = all records

# Step 1: Get the target docs
docs = frappe.db.get_all(target_doctype, filters=target_filters, pluck="name")
print(f"Found {len(docs)} {target_doctype} records to process")

deleted_wf_actions = 0
deleted_docs = 0
errors = []

for docname in docs:
    try:
        # Step 2: Delete linked Workflow Actions first
        wf_actions = frappe.db.get_all(
            "Workflow Action",
            filters={
                "reference_doctype": target_doctype,
                "reference_name": docname
            },
            pluck="name"
        )
        
        for wfa in wf_actions:
            frappe.delete_doc(
                "Workflow Action",
                wfa,
                force=1,
                ignore_permissions=True,
                ignore_on_trash=True,
                delete_permanently=True
            )
            deleted_wf_actions += 1
        
        # Step 3: Delete the parent doc
        frappe.delete_doc(
            target_doctype,
            docname,
            force=1,
            ignore_permissions=True,
            ignore_on_trash=True,
            delete_permanently=True
        )
        deleted_docs += 1
        
    except Exception as e:
        errors.append(f"{docname}: {str(e)}")

print(f"Deleted {deleted_wf_actions} Workflow Actions")
print(f"Deleted {deleted_docs} {target_doctype} records")
if errors:
    print(f"Errors ({len(errors)}):")
    for err in errors:
        print(err)