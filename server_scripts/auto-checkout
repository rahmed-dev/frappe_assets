today = frappe.utils.getdate()
yesterday = frappe.utils.add_days(today, -1)
now = frappe.utils.now_datetime()
today_str = str(today)
yesterday_str = str(yesterday)

in_records = frappe.db.get_all(
    "Employee Checkin",
    filters=[
        ["log_type", "=", "IN"],
        ["custom_is_system_generated", "=", 0],
        ["time", ">=", yesterday_str + " 00:00:00"],
        ["time", "<=", today_str + " 23:59:59"],
    ],
    fields=["employee", "employee_name", "shift", "shift_start", "shift_end", "time"],
    ignore_permissions=True,
)

if not in_records:
    log("shift_auto_checkout: no IN records found")
else:
    out_employee_dates = {
        (r.employee, str(frappe.utils.getdate(r.time)))
        for r in frappe.db.get_all(
            "Employee Checkin",
            filters=[
                ["log_type", "=", "OUT"],
                ["time", ">=", yesterday_str + " 00:00:00"],
                ["time", "<=", today_str + " 23:59:59"],
            ],
            fields=["employee", "time"],
            ignore_permissions=True,
        )
    }

    created = 0

    for rec in in_records:
        rec_date = str(frappe.utils.getdate(rec.time))

        if (rec.employee, rec_date) in out_employee_dates:
            continue

        shift_end = rec.get("shift_end")
        if not shift_end:
            default_shift = frappe.db.get_value("Employee", rec.employee, "default_shift")
            if not default_shift:
                continue
            end_time = frappe.db.get_value("Shift Type", default_shift, "end_time")
            if not end_time:
                continue
            if hasattr(end_time, "total_seconds"):
                secs = int(end_time.total_seconds())
                h, m, s = secs // 3600, (secs % 3600) // 60, secs % 60
            else:
                h, m, s = map(int, str(end_time).split(":"))
            shift_end = frappe.utils.get_datetime(f"{rec_date} {h:02d}:{m:02d}:{s:02d}")
        else:
            shift_end = frappe.utils.get_datetime(shift_end)

        # Skip overnight shifts (end before 6 AM)
        if (shift_end.hour * 3600 + shift_end.minute * 60 + shift_end.second) < (6 * 3600):
            continue

        checkout_time = frappe.utils.add_to_date(shift_end, minutes=15)

        if checkout_time > now:
            continue

        frappe.get_doc({
            "doctype": "Employee Checkin",
            "employee": rec.employee,
            "employee_name": rec.employee_name,
            "log_type": "OUT",
            "time": checkout_time,
            "shift": rec.shift,
            "shift_start": rec.shift_start,
            "shift_end": rec.shift_end,
            "latitude": 0.1,
            "longitude": 0.1,
            "custom_is_system_generated": 1,
        }).insert(ignore_permissions=True)

        out_employee_dates.add((rec.employee, rec_date))
        created += 1

    if created:
        frappe.db.commit()
        log(f"shift_auto_checkout: {created} system OUT(s) inserted")
