now = frappe.utils.now_datetime()
window_start = frappe.utils.add_to_date(now, hours=-30)

output = []
output.append(f"now = {now}")
output.append(f"window_start = {window_start}")

# Step 1: IN records matching script filter
in_records = frappe.db.get_all(
    "Employee Checkin",
    filters={
        "log_type": "IN",
        "custom_is_system_generated": 0,
        "time": [">=", window_start],
    },
    fields=["name", "employee", "shift", "time", "custom_is_system_generated"],
    ignore_permissions=True,
)
output.append(f"--- Filter returned {len(in_records)} IN records ---")
for r in in_records:
    output.append(f"  {r.name} | {r.employee} | shift={r.shift} | time={r.time} | sysgen={r.custom_is_system_generated}")

# Step 2: Sujal's IN — raw SQL
output.append("--- Sujal's IN records (raw) ---")
sujal_in = frappe.db.sql("""
    SELECT name, employee, log_type, shift, shift_start, shift_end,
           time, custom_is_system_generated
    FROM `tabEmployee Checkin`
    WHERE employee = 'HR-EMP-00011' AND log_type = 'IN'
    ORDER BY time DESC
    LIMIT 3
""", as_dict=True)
for r in sujal_in:
    output.append(f"  {r}")

# Step 3: Sujal's OUTs
output.append("--- Sujal's OUT records ---")
sujal_out = frappe.db.sql("""
    SELECT name, time, custom_is_system_generated
    FROM `tabEmployee Checkin`
    WHERE employee = 'HR-EMP-00011' AND log_type = 'OUT'
    ORDER BY time DESC
    LIMIT 3
""", as_dict=True)
for r in sujal_out:
    output.append(f"  {r}")

# Step 4: Regular Shift
output.append("--- Regular Shift config ---")
shift = frappe.db.get_value(
    "Shift Type",
    "Regular Shift",
    ["start_time", "end_time", "enable_auto_attendance"],
    as_dict=True,
)
output.append(f"  {shift}")

frappe.log_error(
    title="Auto-Checkout Diagnostic",
    message="\n".join(output)
)