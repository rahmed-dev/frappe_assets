# Auto Attendance Marking Script
# Runs daily at 2 AM (cron: 0 2 * * *)
# Automates the manual 3-step process on Shift Type:
#   1. Update "Last Sync of Checkin" → now
#   2. Set "Process Attendance After" → day before yesterday (exclusive, so yesterday is processed)
#   3. Click "Mark Attendance" → process_auto_attendance()
# Must run after auto-checkout script so system-generated OUTs are already in place.

now = frappe.utils.now_datetime()
yesterday = frappe.utils.add_days(frappe.utils.getdate(), -1)
day_before_yesterday = frappe.utils.add_days(frappe.utils.getdate(), -2)

shift_types = frappe.db.get_all(
    "Shift Type",
    filters={"enable_auto_attendance": 1},
    fields=["name"],
    ignore_permissions=True,
)

if not shift_types:
    log("auto_attendance: no shift types with auto attendance enabled")
else:
    processed = 0
    for row in shift_types:
        # Step 1 & 2: update sync fields so HRMS knows the date range to process
        frappe.db.set_value(
            "Shift Type",
            row.name,
            {
                "last_sync_of_checkin": now,
                "process_attendance_after": day_before_yesterday,
            },
            update_modified=False,
        )
        # Step 3: trigger HRMS attendance marking logic
        frappe.get_doc("Shift Type", row.name).process_auto_attendance()
        processed += 1

    frappe.db.commit()
    log(f"auto_attendance: processed {processed} shift type(s) for {yesterday}")
